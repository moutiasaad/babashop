{
  "info": {
    "name": "Babashop API",
    "description": "Complete API collection for Babashop — base URL and token are stored as collection variables.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://192.168.100.31:8000/api", "type": "string" },
    { "key": "token",    "value": "",                              "type": "string" },
    { "key": "user_id",  "value": "",                              "type": "string" },
    { "key": "product_id", "value": "1",                           "type": "string" },
    { "key": "order_id",   "value": "1",                           "type": "string" }
  ],
  "item": [

    {
      "name": "Auth",
      "item": [
        {
          "name": "Create Guest User",
          "request": {
            "method": "POST",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{}", "options": { "raw": { "language": "json" } } },
            "url": { "raw": "{{base_url}}/auth/create-guest", "host": ["{{base_url}}"], "path": ["auth","create-guest"] }
          }
        },
        {
          "name": "Register Phone",
          "request": {
            "method": "POST",
            "header": [{ "key": "Accept", "value": "application/json" }, { "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"phone\": \"123456789\"\n}", "options": { "raw": { "language": "json" } } },
            "url": { "raw": "{{base_url}}/register-phone", "host": ["{{base_url}}"], "path": ["register-phone"] }
          }
        },
        {
          "name": "Verify OTP",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var json = pm.response.json();",
                  "if (json.token) { pm.collectionVariables.set('token', json.token); }",
                  "if (json.user && json.user.id) { pm.collectionVariables.set('user_id', json.user.id); }"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Accept", "value": "application/json" }, { "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"user_id\": \"{{user_id}}\",\n  \"otp\": 111111\n}", "options": { "raw": { "language": "json" } } },
            "url": { "raw": "{{base_url}}/verify-otp", "host": ["{{base_url}}"], "path": ["verify-otp"] }
          }
        },
        {
          "name": "Refresh Token",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var json = pm.response.json();",
                  "if (json.token) { pm.collectionVariables.set('token', json.token); }"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Accept", "value": "application/json" }, { "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"user_id\": \"{{user_id}}\"\n}", "options": { "raw": { "language": "json" } } },
            "url": { "raw": "{{base_url}}/auth/refresh-token", "host": ["{{base_url}}"], "path": ["auth","refresh-token"] }
          }
        },
        {
          "name": "Get Authenticated User",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }, { "key": "Accept", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/user", "host": ["{{base_url}}"], "path": ["user"] }
          }
        },
        {
          "name": "Update User Info",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }, { "key": "Accept", "value": "application/json" }, { "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"user_id\": \"{{user_id}}\",\n  \"fullname\": \"Ahmed Benali\",\n  \"email\": \"ahmed@example.com\",\n  \"address\": \"Tunis, Tunisie\",\n  \"birth_date\": \"1995-06-15\",\n  \"latitude\": \"36.8190\",\n  \"longitude\": \"10.1658\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{base_url}}/update-user-info", "host": ["{{base_url}}"], "path": ["update-user-info"] }
          }
        },
        {
          "name": "Update User Info (with image)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }, { "key": "Accept", "value": "application/json" }],
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "user_id",    "value": "{{user_id}}", "type": "text" },
                { "key": "fullname",   "value": "Ahmed Benali","type": "text" },
                { "key": "email",      "value": "ahmed@example.com", "type": "text" },
                { "key": "birth_date", "value": "1995-06-15",  "type": "text" },
                { "key": "image",      "type": "file", "src": "" }
              ]
            },
            "url": { "raw": "{{base_url}}/update-user-info-manual", "host": ["{{base_url}}"], "path": ["update-user-info-manual"] }
          }
        },
        {
          "name": "Destroy Account",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }, { "key": "Accept", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{}", "options": { "raw": { "language": "json" } } },
            "url": { "raw": "{{base_url}}/destroy-account", "host": ["{{base_url}}"], "path": ["destroy-account"] }
          }
        }
      ]
    },

    {
      "name": "Banners",
      "item": [
        {
          "name": "List Active Banners",
          "request": {
