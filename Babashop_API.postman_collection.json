            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }, { "key": "Accept", "value": "application/json" }],
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "image", "type": "file", "src": "" },
                { "key": "link",  "value": "https://example.com", "type": "text" },
                { "key": "order", "value": "0", "type": "text" }
              ]
            },
            "url": { "raw": "{{base_url}}/banners", "host": ["{{base_url}}"], "path": ["banners"] }
          }
        },
        {
          "name": "Update Banner",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }, { "key": "Accept", "value": "application/json" }, { "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"is_active\": true,\n  \"order\": 1,\n  \"link\": \"https://example.com\"\n}", "options": { "raw": { "language": "json" } } },
            "url": { "raw": "{{base_url}}/banners/1", "host": ["{{base_url}}"], "path": ["banners","1"] }
          }
        },
        {
          "name": "Delete Banner",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }, { "key": "Accept", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/banners/1", "host": ["{{base_url}}"], "path": ["banners","1"] }
          }
        }
      ]
    },

