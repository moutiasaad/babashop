                "body": { "mode": "raw", "raw": "{\n  \"name\": \"Taille\",\n  \"values\": [\"S\", \"M\", \"L\", \"XL\"]\n}", "options": { "raw": { "language": "json" } } },
                "url": { "raw": "{{base_url}}/products/{{product_id}}/options/1", "host": ["{{base_url}}"], "path": ["products","{{product_id}}","options","1"] }
