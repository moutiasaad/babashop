    {
      "name": "Products",
      "item": [
        {
          "name": "List Products (home feed)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": {
              "raw": "{{base_url}}/products?price=asc&userid={{user_id}}",
              "host": ["{{base_url}}"],
              "path": ["products"],
              "query": [
                { "key": "price",  "value": "asc",        "description": "asc | desc | omit for random" },
                { "key": "userid", "value": "{{user_id}}", "description": "optional zone filtering" }
              ]
            }
          }
        },
        {
          "name": "Get Product by ID",
          "request": {
            "method": "GET",
